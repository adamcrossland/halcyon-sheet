@page "/"
@inject CharacterStore Store

<PageTitle>Halcyon · Runners</PageTitle>

<div class="page-head">
    <h1>Runners on file</h1>
    <div class="actions">
        <label class="btn">
            Import file…
            <InputFile OnChange="Import" accept=".json,application/json" class="visually-hidden" />
        </label>
        <a class="btn btn-primary" href="create">New runner</a>
    </div>
</div>

<Problems Items="problems" />
@if (message is not null) { <p class="notice">@message</p> }

@if (characters.Count == 0)
{
    <div class="empty">
        <p>No runners on file yet.</p>
        <p><a class="btn btn-primary" href="create">Create your first runner</a></p>
    </div>
}
else
{
    <div class="roster">
        @foreach (var c in characters)
        {
            <article class="roster-card">
                <a class="rc-main" href="character/@c.Id">
                    <h2>@(string.IsNullOrWhiteSpace(c.Name) ? "(unnamed)" : c.Name)</h2>
                    <div class="rc-sub">
                        @(Catalog.FindPeople(c.PeopleId)?.Name) @(Catalog.FindClass(c.ClassId)?.Name) · level @c.Level
                    </div>
                    <div class="rc-stats">
                        <span>HEA @c.HeaCurrent/@CharacterRules.MaxHea(c)</span>
                        <span>GRT @c.GrtCurrent/@CharacterRules.MaxGrt(c)</span>
                        <span>@c.Scrip scrip</span>
                        @if (c.SpillMarks > 0) { <span>@c.SpillMarks mark@(c.SpillMarks == 1 ? "" : "s")</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(c.Player)) { <div class="rc-player">Player: @c.Player</div> }
                </a>
                <div class="rc-actions">
                    <a class="btn btn-sm" href="character/@c.Id">Open</a>
                    <a class="btn btn-sm" href="character/@c.Id/levelup">Level up</a>
                    <a class="btn btn-sm" href="characters/@c.Id/sheet.pdf" target="_blank">PDF</a>
                    <a class="btn btn-sm" href="characters/@c.Id/export.json" download>Export</a>
                    @if (confirmDelete == c.Id)
                    {
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(c.Id)">Really delete</button>
                        <button class="btn btn-sm" @onclick="() => confirmDelete = null">Keep</button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-ghost" @onclick="() => confirmDelete = c.Id">Delete</button>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    List<Character> characters = [];
    Guid? confirmDelete;
    List<string>? problems;
    string? message;

    protected override void OnInitialized() => Load();

    void Load() => characters = Store.List().ToList();

    void Delete(Guid id)
    {
        Store.Delete(id);
        confirmDelete = null;
        Load();
    }

    async Task Import(InputFileChangeEventArgs e)
    {
        problems = null;
        message = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 2_000_000));
            var c = Store.Import(await reader.ReadToEndAsync());
            message = $"Imported {c.Name}.";
            Load();
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or IOException or NotSupportedException)
        {
            problems = [$"Couldn't import that file: {ex.Message}"];
        }
    }
}
